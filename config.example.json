{
  "port": 4010,
  "host": "127.0.0.1",
  "upstream": "https://opencode.ai/zen/go/v1",
  "defaultCooldownMs": 60000,
  "maxFailoverRetries": 2,
  "sessionAffinityEnabled": true,
  "ttftTimeoutMs": 25000,
  "chunkIdleTimeoutMs": 60000,
  "circuitBreaker": {
    "enabled": true,
    "failureThreshold": 3,
    "baseCooldownMs": 5000,
    "maxCooldownMs": 120000,
    "halfOpenMaxProbes": 1
  },
  "accounts": [
    {
      "id": "account-1",
      "name": "OpenCode Go (订阅账号 1)",
      "apiKey": "",
      "enabled": true
    },
    {
      "id": "account-2",
      "name": "OpenCode Go (订阅账号 2)",
      "apiKey": "",
      "enabled": true
    }
  ],
  "compression": {
    "enabled": true,
    "preset": "balanced",
    "modules": {
      "rtk": {
        "enabled": true,
        "stripAnsi": true,
        "cleanProgressBars": true,
        "foldTestPasses": true,
        "cleanDevOpsOutput": true
      },
      "headroom": {
        "enabled": true,
        "foldLockfiles": true,
        "foldStructuredData": true,
        "maxStructuredItems": 50,
        "exemptMergeConflicts": true,
        "protectSourceDiffs": true
      },
      "schema": {
        "enabled": true,
        "alignToolsSchema": true,
        "slimToolsSchema": true,
        "schemaCharThreshold": 15000
      },
      "cacheZone": {
        "enabled": true,
        "cacheZoneFreeze": true,
        "trueLruRetention": true
      }
    }
  }
}
